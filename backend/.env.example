# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL (local — no Docker)
DATABASE_URL="postgresql://postgres:password@localhost:5432/sellerflow_dev"

# Auth
JWT_SECRET=sellerflow-jwt-secret-min-32-chars-change-in-prod
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=sellerflow-refresh-secret-min-32-chars
REFRESH_TOKEN_EXPIRES_IN=30d
ENCRYPTION_KEY=sellerflow-encrypt-32chars-change!

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# eBay OAuth — use SANDBOX for local dev
# Get from: developer.ebay.com
EBAY_CLIENT_ID=your-sandbox-app-id
EBAY_CLIENT_SECRET=your-sandbox-cert-id
EBAY_REDIRECT_URI=http://localhost:4000/api/ebay/callback
EBAY_ENVIRONMENT=sandbox
EBAY_BASE_URL=https://api.sandbox.ebay.com
EBAY_SIGNIN_URL=https://signin.sandbox.ebay.com

# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_STARTER_PRICE_ID=price_xxxx
STRIPE_GROWTH_PRICE_ID=price_xxxx
STRIPE_PRO_PRICE_ID=price_xxxx
